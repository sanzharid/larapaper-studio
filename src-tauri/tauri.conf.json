{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Larapaper Studio",
  "version": "0.1.0",
  "identifier": "com.larapaper.studio",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Larapaper Studio",
        "width": 1480,
        "height": 940,
        "minWidth": 1120,
        "minHeight": 720,
        "backgroundColor": "#16181d",
        "dragDropEnabled": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http: https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
